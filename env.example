PORT=7860

WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt
# 0 libera o Whisper da RAM após cada análise; 1 deixa carregado para ganhar velocidade.
WHISPER_KEEP_MODEL_LOADED=0

APP_USERNAME=
APP_PASSWORD=

MAX_VIDEO_MINUTES=10
MAX_UPLOAD_SIZE=500mb
OUTPUT_CRF=21
OUTPUT_PRESET=veryfast
OUTPUT_AUDIO_BITRATE=160k
CAPTION_FONT=DejaVu Sans
TEMP_MAX_AGE_HOURS=1.5

OUTPUT_MAX_LONG_EDGE=1920
FFMPEG_THREADS=1
BACKGROUND_BLUR_DIVISOR=4
TRANSITION_MAX_SCAN_SECONDS=60

# OCR econômico/mais limpo
OCR_MAX_SAMPLES=8
OCR_SAMPLE_STEP_SECONDS=0.9
OCR_CROP_TOP_PERCENT=5
OCR_CROP_BOTTOM_PERCENT=8
OCR_CROP_SIDE_PERCENT=1

MAX_INSTAGRAM_DOWNLOAD_MB=500
INSTAGRAM_COOKIES_B64=
INSTAGRAM_COOKIES=
INSTAGRAM_FORCE_IPV4=0
