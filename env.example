# O Railway fornece PORT automaticamente; localmente usa 7860.
PORT=7860

# PROTEJA a interface se o endereço do Railway for público.
APP_USERNAME=
APP_PASSWORD=
# API POST /api/import-video desativada sem token. Use um valor longo/aleatório.
IMPORT_API_TOKEN=

# Limites anti-abuso e de custo. Aumente somente se necessário.
MAX_VIDEO_MINUTES=10
MAX_UPLOAD_SIZE=200mb
MAX_INSTAGRAM_DOWNLOAD_MB=200

# Exportação padrão e econômica; qualidade econômica configurada na interface.
OUTPUT_CRF=21
OUTPUT_PRESET=veryfast
OUTPUT_AUDIO_BITRATE=160k
OUTPUT_MAX_LONG_EDGE=1920
FFMPEG_THREADS=1
BACKGROUND_BLUR_DIVISOR=4

# Whisper não permanece carregado enquanto você não precisa dele.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt
WHISPER_KEEP_MODEL_LOADED=0

CAPTION_FONT=DejaVu Sans
TRANSITION_MAX_SCAN_SECONDS=60
TEMP_MAX_AGE_HOURS=3
GRADIO_CACHE_MAX_AGE_HOURS=6

# Reduz tráfego de telemetria externa e permite suspensão do serviço.
GRADIO_ANALYTICS_ENABLED=False
GRADIO_TELEMETRY_ENABLED=False
HF_HUB_DISABLE_TELEMETRY=1

OCR_MAX_SAMPLES=8
OCR_SAMPLE_STEP_SECONDS=0.9
OCR_CROP_TOP_PERCENT=1
OCR_CROP_BOTTOM_PERCENT=3
OCR_CROP_SIDE_PERCENT=0

# Instagram público: se o servidor bloquear importação, configure cookies.
INSTAGRAM_COOKIES_B64=
INSTAGRAM_COOKIES=
INSTAGRAM_FORCE_IPV4=0
